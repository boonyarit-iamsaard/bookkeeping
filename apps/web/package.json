{
  "name": "@bookkeeping/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/generate-api.ts --check && vite build",
    "dev": "vite --port 4000 --strictPort",
    "generate:api": "tsx scripts/generate-api.ts",
    "generate:icons": "pwa-assets-generator",
    "start": "vite preview --port 4000 --strictPort",
    "test": "vitest run",
    "test:e2e": "tsx tests/e2e/run.ts",
    "test:e2e:ci": "dotenvx run -f .env --ignore=MISSING_ENV_FILE --env CI=1 -- tsx tests/e2e/run.ts",
    "test:watch": "vitest",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@bookkeeping/domain": "workspace:*",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.52.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@bookkeeping/database": "workspace:*",
    "@bookkeeping/server": "workspace:*",
    "@dotenvx/dotenvx": "^2.32.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
}
