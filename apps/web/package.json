    "test:watch": "vitest",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@bookkeeping/domain": "workspace:*",
    "@tanstack/react-query": "^5.103.1",
