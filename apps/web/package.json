    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.45.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@bookkeeping/database": "workspace:*",
    "@dotenvx/dotenvx": "^2.28.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4",
