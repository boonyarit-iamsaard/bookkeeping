{
  "name": "@bookkeeping/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --port 4000 --strictPort",
    "start": "vite preview --port 4000 --strictPort",
    "test": "vitest run",
    "test:e2e": "tsx tests/e2e/run.ts",
