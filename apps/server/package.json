{
  "name": "@bookkeeping/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@bookkeeping/application": "workspace:*",
    "@bookkeeping/auth": "workspace:*",
    "@bookkeeping/database": "workspace:*",
    "@bookkeeping/domain": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "hono-openapi": "^1.3.3",
    "pg": "^8.23.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.9.1",
    "@types/node": "^20",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
