{
  "name": "@bookkeeping/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "dev": "dotenvx run -f .env --ignore=MISSING_ENV_FILE -- tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "password:reset": "dotenvx run -f .env --ignore=MISSING_ENV_FILE -- tsx src/reset-password-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "hono-openapi": "^1.3.3",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@bookkeeping/application": "workspace:*",
    "@bookkeeping/auth": "workspace:*",
    "@bookkeeping/database": "workspace:*",
    "@bookkeeping/domain": "workspace:*",
    "@dotenvx/dotenvx": "^2.30.0",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@types/node": "^24",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
