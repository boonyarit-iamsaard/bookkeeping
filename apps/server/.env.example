# Local API origin: http://localhost:5000. HOST and PORT are optional and
# these are the server's own defaults.
HOST=0.0.0.0
PORT=5000

# Only the API holds this secret: it signs the API's sessions. At least 32
# characters; generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-a-32-character-secret

# The API origin; keep it in step with HOST and PORT and with VITE_API_ORIGIN
# in apps/web/.env. Its session cookie is host-only.
BETTER_AUTH_URL=http://localhost:5000

# Comma-separated browser origins allowed to send credentialed requests.
CLIENT_ORIGINS=http://localhost:4000

# Optional: true or false. Unset, Better Auth throttles sign-in and sign-up
# only under NODE_ENV=production.
# AUTH_RATE_LIMIT_ENABLED=true

# Optional: true or false, default true. Production sets false once the
# owner's account exists; sign-in keeps working.
# AUTH_SIGN_UP_ENABLED=true

DATABASE_URL=postgresql://postgres:password@localhost:5432/bookkeeping
