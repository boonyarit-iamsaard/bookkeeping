{
  "name": "@bookkeeping/legacy-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "dotenvx run --env SKIP_ENV_VALIDATION=1 -- next build",
    "dev": "next dev -p 4000",
    "start": "dotenvx run --env PORT=4000 -- next start",
    "test": "vitest run",
    "test:e2e": "tsx tests/e2e/run.ts",
    "test:e2e:ci": "dotenvx run --env CI=1 -- tsx tests/e2e/run.ts",
    "test:watch": "vitest",
    "types:check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@bookkeeping/application": "workspace:*",
    "@bookkeeping/auth": "workspace:*",
    "@bookkeeping/database": "workspace:*",
    "@bookkeeping/domain": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-form": "^1.33.5",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.28.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
