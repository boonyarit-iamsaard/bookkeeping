# 32 characters or more. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32-character-secret

# Local web origin: http://localhost:4000. The port is set by the dev and
# start scripts in package.json; keep BETTER_AUTH_URL in step with it.
BETTER_AUTH_URL=http://localhost:4000

DATABASE_URL=postgresql://postgres:password@localhost:5432/bookkeeping
