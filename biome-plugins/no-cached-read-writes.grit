language js

// A regex on the callee text, because Biome's Grit cannot compile `?.` patterns.
// The bracket form `client["removeQueries"]()` is matched too.
// shortcut: a destructured call (`const { setQueryData } = client`) is not
// reported, because Grit cannot compile that pattern; the detached method
// throws on its missing `this`, so a test finds it. Upgrade when Grit can.
`$callee($args)` where {
  $callee <: r".*(?:[.]|\[[\"'])(?:invalidateQueries|removeQueries|resetQueries|setQueryData|setQueriesData)(?:[\"']\])?",
  register_diagnostic(span=$callee, severity="error", message="Only refreshAfterWrite and forgetReads in core/query/refresh-after-write.ts change cached reads. Call refreshAfterWrite after a write, or forgetReads for a deleted record's retired reads.")
}
