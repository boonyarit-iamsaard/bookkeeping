language js

// Matches any `.clear()`: Grit cannot see types, so Map.clear() is reported
// too. Suppress it with `// biome-ignore lint/plugin: <reason>`.
`$callee($args)` where {
  $callee <: r".*[.]clear",
  register_diagnostic(span=$callee, severity="error", message="Only resetSessionCache in core/auth/session.ts clears every cached read. Call resetSessionCache on a session change. For a clear() on something else, add // biome-ignore lint/plugin: <reason>.")
}
