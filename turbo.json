{
  "$schema": "./node_modules/turbo/schema.json",
  "globalPassThroughEnv": [
    "SONAR_ADMIN_LOGIN",
    "SONAR_ADMIN_PASSWORD",
    "SONAR_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["HOST", "PORT"]
    },
    "//#types:check:scripts": {},
    "types:check": {},
    "test": {}
  }
}
