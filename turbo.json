{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["HOST", "PORT"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"],
      "passThroughEnv": ["HOST", "PORT"]
    },
    "//#types:check:scripts": {},
    "//#test:scripts": {},
    "types:check": {},
    "test": {},
    "test:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
