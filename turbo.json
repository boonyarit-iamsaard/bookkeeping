{
  "$schema": "./node_modules/turbo/schema.json",
  "envMode": "strict",
  "globalEnv": ["CI"],
  "globalPassThroughEnv": [
    "SONAR_ADMIN_LOGIN",
    "SONAR_ADMIN_PASSWORD",
    "SONAR_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#types:check:scripts": {},
    "types:check": {},
    "test": {},
    "test:e2e": {
      "dependsOn": ["build"]
    }
  }
}
