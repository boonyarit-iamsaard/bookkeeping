{
  "biome.enabled": true,
  "css.lint.unknownAtRules": "ignore",
  "eslint.enable": false,
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "[markdown]": {
    "files.trimTrailingWhitespace": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // CloudFormation's short-form intrinsic functions, such as `!Ref` and
  // `!Sub` in `infra/aws/`, which the YAML extension otherwise flags as
  // unresolved tags.
  "yaml.customTags": [
    "!And sequence",
    "!Base64 scalar",
    "!Base64 mapping",
    "!Cidr sequence",
    "!Condition scalar",
    "!Equals sequence",
    "!FindInMap sequence",
    "!GetAtt scalar",
    "!GetAtt sequence",
    "!GetAZs scalar",
    "!If sequence",
    "!ImportValue scalar",
    "!ImportValue mapping",
    "!Join sequence",
    "!Not sequence",
    "!Or sequence",
    "!Ref scalar",
    "!Select sequence",
    "!Split sequence",
    "!Sub scalar",
    "!Sub sequence"
  ],
  // SonarLint does not read sonar-project.properties, so the accepted S3
  // access-logging and SNS encryption rules are turned off here too; see
  // infra/aws/backups.yaml.
  "sonarlint.rules": {
    "cloudformation:S6258": { "level": "off" },
    "cloudformation:S6327": { "level": "off" }
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript][javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json][jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript][typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  }
}
