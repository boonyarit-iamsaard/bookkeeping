# Used by the local database commands (`pnpm db:push`, `pnpm db:migrate`,
# `pnpm db:studio`). `pnpm db:fresh` and `pnpm db:seed` read `packages/seed/.env`.
# Runtime consumers inject their own validated DATABASE_URL. This value points at
# the local PostgreSQL from docker-compose.yaml, whose fixed credentials it
# matches.
DATABASE_URL=postgresql://postgres:password@localhost:5432/bookkeeping
