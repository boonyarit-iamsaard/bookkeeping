# Used by the local database commands (`pnpm db:push`, `pnpm db:migrate`,
# `pnpm db:fresh`, `pnpm db:seed`, `pnpm db:studio`); `db:fresh` and `db:seed`
# run from `packages/seed` and read this file. Runtime consumers inject their own
# validated DATABASE_URL. This value points at the local PostgreSQL from
# docker-compose.yaml, whose fixed credentials it matches.
DATABASE_URL=postgresql://postgres:password@localhost:5432/bookkeeping
