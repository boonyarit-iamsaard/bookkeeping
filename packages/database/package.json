{
  "name": "@bookkeeping/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./connection": "./src/connection.ts",
    "./errors": "./src/database-error.ts",
    "./auth": "./src/auth/auth.schema.ts",
    "./wallets": "./src/wallets/wallet.schema.ts",
    "./categories": "./src/categories/category.schema.ts",
    "./idempotency": "./src/idempotency/creation-receipt.schema.ts",
    "./transactions": "./src/transactions/transaction.schema.ts",
    "./testing": "./src/testing/test-database.ts",
    "./testing/global-setup": "./src/testing/global-setup.ts",
    "./testing/start-database": "./src/testing/start-database.ts",
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "db:push": "dotenvx run -f .env --ignore=MISSING_ENV_FILE -- drizzle-kit push",
    "db:migrate": "dotenvx run -f .env --ignore=MISSING_ENV_FILE -- tsx src/migrate-cli.ts",
    "db:fresh": "dotenvx run -f .env --ignore=MISSING_ENV_FILE -- tsx src/fresh-cli.ts",
    "db:studio": "dotenvx run -f .env --ignore=MISSING_ENV_FILE -- drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@bookkeeping/domain": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0",
    "pg-connection-string": "^2.14.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.30.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  }
}
