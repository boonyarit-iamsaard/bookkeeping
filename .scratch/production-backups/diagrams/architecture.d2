# Production backups: where the ledger goes every night.
# Render instructions: README.md beside this file.

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 0
    dark-theme-id: 200
    pad: 40
  }
}

direction: right

railway: Railway · production project {
  direction: down
  private: private network {
    style.stroke-dash: 3
    postgres: PostgreSQL 18 {
      shape: cylinder
    }
    backup: backup cron\n03:00 Asia/Bangkok {
      icon: https://icons.terrastruct.com/essentials%2F112-server.svg
    }
    postgres -> backup: pg_dump + manifest\none snapshot
  }

  snapshots: Railway volume backups\nfirst layer, same account {
    style.stroke-dash: 3
  }
  private.postgres -> snapshots: daily · weekly · monthly {
    style.stroke-dash: 3
  }
}

aws: AWS Organization · backups account · ap-southeast-1 {
  direction: down
  bucket: S3 bucket {
    icon: https://icons.terrastruct.com/aws%2FStorage%2FAmazon-Simple-Storage-Service-S3.svg
  }
  rules: |md
    **Object Lock** compliance, 35 days\
    `daily/` kept 35 days\
    `monthly/` kept 12 months
  |
  bucket -- rules: {style.stroke-dash: 2}

  alert: missing-backup check {
    direction: right
    scheduler: EventBridge\n09:00 daily {
      icon: https://icons.terrastruct.com/aws%2FApplication%20Integration%2FAmazon-EventBridge.svg
    }
    check: Lambda\nnewest > 26 h? {
      icon: https://icons.terrastruct.com/aws%2FCompute%2FAWS-Lambda.svg
    }
    sns: SNS {
      icon: https://icons.terrastruct.com/aws%2FApplication%20Integration%2FAmazon-Simple-Notification-Service-SNS.svg
    }
    scheduler -> check
    check -> sns: missing
  }
  alert.check -> bucket: list daily/

  budget: 'Budgets · $1 alert' {
    icon: https://icons.terrastruct.com/aws%2FAWS%20Cost%20Management%2FAWS-Budgets.svg
  }
}

owner: Owner {
  shape: person
}
drill: Owner's machine · restore drill\npostgres:18 container, compare to manifest

railway.private.backup -> aws.bucket: PutObject only\nage-encrypted {
  style.stroke-width: 3
}
aws.alert.sns -> owner: email
aws.budget -> owner: email {style.stroke-dash: 3}
drill -> aws.bucket: aws sso login · read
owner -> drill: age private key
