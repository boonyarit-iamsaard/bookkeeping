{
  "name": "bookkeeping",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "lint": "biome check --no-errors-on-unmatched --files-ignore-unknown=true",
    "format": "prettier --write \"**/*.{md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{md,yaml,yml}\"",
    "lint:md": "markdownlint \"**/*.md\" --ignore-path .gitignore",
    "lint:md:fix": "markdownlint --fix \"**/*.md\" --ignore-path .gitignore",
    "types:check": "tsc --noEmit",
    "ci": "biome ci --no-errors-on-unmatched --files-ignore-unknown=true . && pnpm format:check && pnpm lint:md && pnpm types:check && pnpm build",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.27.0",
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,css}": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ],
    "*.{md,yaml,yml}": [
      "prettier --check"
    ],
    "*.md": [
      "markdownlint --ignore-path .gitignore --ignore CLAUDE.md"
    ]
  }
}
