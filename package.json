{
  "name": "bookkeeping",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "ci": "pnpm check:database-migrations && biome ci --no-errors-on-unmatched --files-ignore-unknown=true . && pnpm format:check && pnpm lint:md && turbo run types:check types:check:scripts test test:scripts && turbo run build",
    "ci:e2e": "turbo run test:e2e:ci",
    "db:push": "pnpm --filter @bookkeeping/database db:push",
    "db:migrate": "pnpm --filter @bookkeeping/database db:migrate",
    "db:fresh": "pnpm --filter @bookkeeping/database db:fresh",
    "db:start": "docker compose up -d --wait",
    "db:stop": "docker compose --profile stack down",
    "db:studio": "pnpm --filter @bookkeeping/database db:studio",
    "check:database-migrations": "tsx scripts/check-database-migrations.ts",
    "dev": "turbo run dev",
    "dev:server": "turbo run dev --filter=@bookkeeping/server",
    "dev:web": "turbo run dev --filter=@bookkeeping/web",
    "fix": "pnpm check && pnpm format && pnpm lint:md:fix",
    "format": "prettier --write \"**/*.{md,yaml,yml,html}\"",
    "format:check": "prettier --check \"**/*.{md,yaml,yml,html}\"",
    "generate:api": "pnpm --filter @bookkeeping/web generate:api",
    "lint": "biome check --no-errors-on-unmatched --files-ignore-unknown=true",
    "lint:md": "markdownlint \"**/*.md\" --ignore-path .gitignore",
    "lint:md:fix": "markdownlint --fix \"**/*.md\" --ignore-path .gitignore",
    "prepare": "husky || true",
    "sonar:export": "tsx --env-file=.env.sonar scripts/sonar-export.ts",
    "sonar:scan": "tsx --env-file=.env.sonar scripts/sonar-scan.ts",
    "sonar:setup": "pnpm sonar:start && tsx --env-file-if-exists=.env.sonar scripts/sonar-setup.ts",
    "sonar:start": "docker compose -f docker-compose.sonar.yaml up -d postgres sonarqube",
    "sonar:stop": "docker compose -f docker-compose.sonar.yaml down",
    "stack:build": "docker compose --profile stack build server && docker compose --profile stack build web",
    "stack:logs": "docker compose --profile stack logs --follow server web",
    "stack:start": "pnpm stack:build && docker compose --profile stack up -d --no-build --wait",
    "stack:stop": "docker compose --profile stack rm --stop --force web server",
    "start": "turbo run start",
    "start:server": "turbo run start --filter=@bookkeeping/server",
    "start:web": "turbo run start --filter=@bookkeeping/web",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:scripts": "vitest run",
    "test:watch": "turbo run test:watch",
    "types:check": "turbo run types:check types:check:scripts",
    "types:check:scripts": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^20",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "turbo": "^2",
    "typescript": "^5",
    "vitest": "^5.0.0",
    "zod": "^4.6.2"
  },
  "packageManager": "pnpm@10.27.0",
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,css}": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ],
    "*.{md,yaml,yml,html}": [
      "prettier --check"
    ],
    "*.md": [
      "markdownlint --ignore-path .gitignore --ignore CLAUDE.md"
    ]
  }
}
